# Copy to .env (git-ignored) and set a local password. Used by docker-compose.yml
# and by the backend (rag-pipeline/config.py loads this file).
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://postgres:change-me-local-only@localhost:5432/arogya_rag

# Optional backend overrides (defaults shown)
# GENERATION_PROVIDER=transformers
# LOCAL_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RERANKER_MODEL=BAAI/bge-reranker-base

# Optional (Docker): reuse an existing Hugging Face model cache instead of downloading ~2.2 GB
# HF_CACHE=C:/Users/<you>/.cache/huggingface
