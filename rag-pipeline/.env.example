# Optional backend-only overrides: copy to rag-pipeline/.env (git-ignored). Never commit .env files.
# DATABASE_URL is read from the repo-root .env (shared with docker-compose.yml).
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/arogya_rag

# Retrieval models (Hugging Face, run locally on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# Local generation provider: transformers | ollama | extractive  (no cloud provider exists)
GENERATION_PROVIDER=transformers
LOCAL_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
# OLLAMA_URL=http://127.0.0.1:11434   (only used when GENERATION_PROVIDER=ollama; must be localhost)

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PORT=8010
